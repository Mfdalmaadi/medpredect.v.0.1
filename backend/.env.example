APP_NAME=MedPredict AI API
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=medpredict
MYSQL_PASSWORD=medpredict_password
MYSQL_DATABASE=medpredict_ai

DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE=1800

JWT_SECRET_KEY=change_this_secret_key_in_development
JWT_REFRESH_SECRET_KEY=change_this_refresh_secret_key_in_development
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

HIGH_RISK_NOTIFICATION_THRESHOLD=0.66

# Optional: Provide full cloud database connection string (e.g. from Aiven or TiDB Cloud)
# DATABASE_URL=mysql+pymysql://user:password@host:port/database

# Allowed CORS origins (comma-separated). Set to your deployed Vercel domain in production
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
